@using DoctorAppointmentSystem.Shared.Enums

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DocApp System</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        </div>

        <AuthorizeView Context="navContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-appointments">My Schedule</NavLink>
                </div>

                @* 🚨 FIX: Rename the inner context to avoid RZ9999 *@
                <AuthorizeView Roles="Admin" Context="adminContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin-dashboard">Admin Dashboard</NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Login</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">Register</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>