@page "/login"
@rendermode InteractiveServer
@using DoctorAppointmentSystem.Shared.DTOs.Request
@using DoctorAppointmentSystem.UI.Services.Interfaces
@inject IAuthClientService AuthService
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 card p-4 shadow border-0">
            <h3 class="text-center mb-4 text-primary">Login</h3>
            
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="admin@docapp.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100 shadow-sm mt-2">Sign In</button>
            </EditForm>
            
            <div class="mt-3 text-center small text-muted">
                Need an account? <a href="/register" class="text-decoration-none">Register</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginRequestDto loginModel { get; set; } = new();

    private async Task HandleLogin()
    {
        try
        {
            await AuthService.LoginAsync(loginModel);
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            // Add error handling if needed
        }
    }
}